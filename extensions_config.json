{
  "_comment": "DeerFlow 的 MCP 服务配置。enabled=true 表示启用该服务；密码、Token 等敏感信息建议通过环境变量引用。",
  "middlewares": [],
  "_middlewares_comment": "中间件配置。通常保持为空；只有确认存在对应 Python 模块时才填写。",
  "mcpInterceptors": [
    "my_package.mcp.auth:build_auth_interceptor"
  ],
  "_mcpInterceptors_comment": "MCP 拦截器配置。当前示例路径需要确保对应 Python 包已安装，否则建议删除该条目。",
  "mcpServers": {
    "github": {
      "_comment": "GitHub MCP：通过 npx 启动，需要设置 GITHUB_TOKEN 环境变量。",
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "description": "用于 GitHub 仓库操作的 MCP 服务"
    },
    "parallel-search": {
      "_comment": "Parallel Search MCP：提供网页搜索和网页内容抓取功能。",
      "enabled": true,
      "type": "http",
      "url": "https://search.parallel.ai/mcp",
      "headers": {
        "User-Agent": "deer-flow"
      },
      "description": "可选的匿名网页搜索和网页内容抓取 MCP 服务"
    },
    "openviking": {
      "_comment": "OpenViking MCP：需要本机运行 OpenViking，并设置 OPENVIKING_API_KEY。",
      "enabled": false,
      "type": "http",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "X-API-Key": "$OPENVIKING_API_KEY"
      },
      "description": "用于显式记忆和资源操作的 OpenViking 官方 MCP 服务"
    },
    "postgres": {
      "_comment": "PostgreSQL MCP：需要修改数据库连接字符串，并确保数据库服务可访问。",
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://localhost/mydb"
      ],
      "env": {},
      "description": "PostgreSQL 数据库访问",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": [
          "database",
          "SQL",
          "table",
          "订单",
          "用户"
        ]
      },
      "tools": {
        "query": {
          "routing": {
            "mode": "prefer",
            "priority": 100,
            "keywords": [
              "查库",
              "订单表",
              "指标"
            ]
          }
        }
      }
    },
    "long-running-reports": {
      "_comment": "长任务报告 MCP 示例：当前 URL 是占位地址，未配置真实服务时不要启用。",
      "enabled": false,
      "type": "http",
      "url": "https://reports.example.com/mcp",
      "description": "普通 MCP 后台任务协议示例",
      "session_init_timeout": 60,
      "tool_call_timeout": 60,
      "task_toolsets": [
        {
          "name": "report-generation",
          "submit_tool": "submit_report",
          "status_tool": "get_report_status",
          "cancel_tool": "cancel_report"
        }
      ]
    }
  },
  "_skills_comment": "技能启用状态配置。格式为技能名称对应 {\"enabled\": true/false}。",
  "skills": {}
}
